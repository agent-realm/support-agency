#!/usr/bin/env python3
"""desk -- the support agent's side of the support agency.

The support member can do two things in a customer's house, and only after that customer
enrolled it: INSERT a request, and read the answers. Every answer was produced and approved on
the customer's side, by the customer's own agent and human.

  desk clients                        houses that enrolled you (from your own grants)
  desk open <house> --title TEXT      open a case; prints the case id
  desk ask <house> <case> <kind> [key=value ...]
                                      ask one typed question; prints the request id
  desk note <house> <case> TEXT       tell the customer something (a diagnosis, a question)
  desk fix <house> <case> --stmt SQL [--stmt SQL ...] [--why TEXT]
                                      propose a fix; only the customer can apply it
  desk close <house> <case> [--why TEXT]
  desk answers <house> [--case C] [--req R] [--json]
  desk wait <house> <req_id> [--timeout SECONDS]
                                      poll until that request is answered, then print the answer

Kinds: server_info, tables_overview, table_schema (database=, table=), parts_health,
slow_queries (hours=, limit=), explain (normalized_query_hash=, mode=indexes|plan), errors.
There is no free SQL. A customer's gate refuses anything else.

Config: $SUPPORT_DESK_CONFIG, default ~/.support-desk/config.json, with realm_url,
realm_curlrc (a curl config holding your member's credentials) and member.
"""
import base64, hashlib, json, os, re, secrets, sys, time, urllib.error, urllib.parse, urllib.request

IDENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
KINDS = ("server_info", "tables_overview", "table_schema", "parts_health", "slow_queries", "explain", "errors")


def die(msg, code=1):
    print(f"desk: {msg}", file=sys.stderr)
    sys.exit(code)


def load_config():
    path = os.path.expanduser(os.environ.get("SUPPORT_DESK_CONFIG", "~/.support-desk/config.json"))
    try:
        with open(path) as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        die(f"cannot read config {path}: {e}", 3)
    for k in ("realm_url", "realm_curlrc", "member"):
        if not cfg.get(k):
            die(f"config: {k} is missing", 3)
    return cfg


def curlrc_user(path):
    with open(os.path.expanduser(path)) as f:
        for line in f:
            m = re.match(r'\s*user\s*=\s*"([^":]+):(.*)"\s*$', line)
            if m:
                return m.group(1), m.group(2).replace('\\"', '"').replace("\\\\", "\\")
    die(f"no user line in {path}", 3)


class Desk:
    def __init__(self, cfg):
        self.url = cfg["realm_url"].rstrip("/")
        self.auth = curlrc_user(cfg["realm_curlrc"])
        self.member = cfg["member"]

    def q(self, sql, fmt="JSONEachRow"):
        req = urllib.request.Request(self.url + "/?" + urllib.parse.urlencode({"default_format": fmt}),
                                     data=sql.encode(), method="POST")
        token = base64.b64encode(f"{self.auth[0]}:{self.auth[1]}".encode()).decode()
        req.add_header("Authorization", "Basic " + token)
        req.add_header("User-Agent", "support-desk/0.1")   # a realm behind a CDN may refuse the stdlib's default
        try:
            with urllib.request.urlopen(req, timeout=60) as r:
                return r.read().decode()
        except urllib.error.HTTPError as e:
            die("the realm refused: " + (e.read().decode(errors="replace").strip().splitlines() or [""])[0][:300])
        except urllib.error.URLError as e:
            die(f"the realm is unreachable: {e.reason}")


def rows(text):
    return [json.loads(line) for line in text.splitlines() if line.strip()]


def house_arg(h):
    if not IDENT.match(h):
        die("a house is a plain name", 3)
    return h


def new_id(prefix):
    return f"{prefix}{time.strftime('%Y%m%d')}-{secrets.token_hex(4)}"


def opt_all(argv, name):
    return [argv[i + 1] for i, a in enumerate(argv) if a == name and i + 1 < len(argv)]


def opt(argv, name, default=None):
    v = opt_all(argv, name)
    return v[0] if v else default


def put(d, house, case_id, kind, args):
    req_id = new_id("r")
    row = {"case_id": case_id, "req_id": req_id, "kind": kind, "args": json.dumps(args, sort_keys=True)}
    d.q(f"INSERT INTO {house}.support_requests (case_id, req_id, kind, args) FORMAT JSONEachRow\n"
        + json.dumps(row), fmt="TSV")
    return req_id


def cmd_clients(d, argv):
    grants = d.q(f"SHOW GRANTS FOR {d.member}", fmt="TSV")
    ins = set(re.findall(r"GRANT [^\n]*\bINSERT\b[^\n]* ON (\w+)\.support_requests TO", grants))
    sel = set(re.findall(r"GRANT [^\n]*\bSELECT\b[^\n]* ON (\w+)\.support_answers TO", grants))
    for h in sorted(ins | sel):
        state = "enrolled" if h in ins and h in sel else ("can ask only" if h in ins else "can read only")
        print(f"{h}\t{state}")
    if not ins | sel:
        print("no customer has enrolled you")


def cmd_open(d, argv):
    if not argv:
        die("usage: desk open <house> --title TEXT", 3)
    house = house_arg(argv[0])
    case_id = new_id("c")
    req_id = put(d, house, case_id, "open", {"title": opt(argv, "--title", "")})
    print(f"case {case_id} (request {req_id})")


def cmd_ask(d, argv):
    if len(argv) < 3:
        die("usage: desk ask <house> <case> <kind> [key=value ...]", 3)
    house, case_id, kind = house_arg(argv[0]), argv[1], argv[2]
    if kind not in KINDS:
        die(f"'{kind}' is not a kind a gate answers: {', '.join(KINDS)}", 3)
    args = {}
    for kv in argv[3:]:
        k, _, v = kv.partition("=")
        args[k] = int(v) if v.isdigit() and k != "normalized_query_hash" else v
    print(put(d, house, case_id, kind, args))


def cmd_note(d, argv):
    if len(argv) < 3:
        die("usage: desk note <house> <case> TEXT", 3)
    print(put(d, house_arg(argv[0]), argv[1], "note", {"text": " ".join(argv[2:])}))


def cmd_fix(d, argv):
    stmts = opt_all(argv, "--stmt")
    if len(argv) < 2 or not stmts:
        die("usage: desk fix <house> <case> --stmt SQL [--stmt SQL ...] [--why TEXT]", 3)
    print(put(d, house_arg(argv[0]), argv[1], "apply", {"statements": stmts, "why": opt(argv, "--why", "")}))


def cmd_close(d, argv):
    if len(argv) < 2:
        die("usage: desk close <house> <case> [--why TEXT]", 3)
    print(put(d, house_arg(argv[0]), argv[1], "close", {"why": opt(argv, "--why", "")}))


def fetch(d, house, case_id=None, req_id=None):
    where = []
    if case_id:
        where.append(f"case_id = '{re.sub(r'[^A-Za-z0-9_-]', '', case_id)}'")
    if req_id:
        where.append(f"req_id = '{re.sub(r'[^A-Za-z0-9_-]', '', req_id)}'")
    out = rows(d.q("SELECT case_id, req_id, toString(at) AS at, author, status, approved_by, reason, payload, "
                   f"payload_sha256 FROM {house}.support_answers "
                   + ("WHERE " + " AND ".join(where) if where else "") + " ORDER BY at"))
    for a in out:
        # The room's author column is stamped by the server; the house's owner is the only writer.
        a["verified"] = (a["author"] == house and
                         hashlib.sha256(a["payload"].encode()).hexdigest() == a["payload_sha256"])
    return out


def show(a, as_json):
    if as_json:
        print(json.dumps(a))
        return
    who = f", approved by {a['approved_by']}" if a["approved_by"] else ""
    print(f"{a['req_id']}  case {a['case_id']}  {a['status']}{who}  {a['at']}"
          + ("" if a["verified"] else "  UNVERIFIED"))
    if a["reason"]:
        print(f"  reason: {a['reason']}")
    if a["payload"]:
        print("  " + json.dumps(json.loads(a["payload"]), indent=1).replace("\n", "\n  "))


def cmd_answers(d, argv):
    if not argv:
        die("usage: desk answers <house> [--case C] [--req R] [--json]", 3)
    out = fetch(d, house_arg(argv[0]), opt(argv, "--case"), opt(argv, "--req"))
    if not out and "--json" not in argv:
        print("no answers yet")
    for a in out:
        show(a, "--json" in argv)


def cmd_wait(d, argv):
    if len(argv) < 2:
        die("usage: desk wait <house> <req_id> [--timeout SECONDS]", 3)
    house, req_id = house_arg(argv[0]), argv[1]
    deadline = time.time() + int(opt(argv, "--timeout", "600"))
    while True:
        out = fetch(d, house, req_id=req_id)
        if out:
            show(out[-1], "--json" in argv)
            return
        if time.time() > deadline:
            die(f"no answer to {req_id} yet", 2)
        time.sleep(3)


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmds = {"clients": cmd_clients, "open": cmd_open, "ask": cmd_ask, "note": cmd_note, "fix": cmd_fix,
            "close": cmd_close, "answers": cmd_answers, "wait": cmd_wait}
    if sys.argv[1] not in cmds:
        die(f"unknown command {sys.argv[1]}", 3)
    cmds[sys.argv[1]](Desk(load_config()), sys.argv[2:])


if __name__ == "__main__":
    main()
