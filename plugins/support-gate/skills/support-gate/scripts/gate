#!/usr/bin/env python3
"""gate -- the customer's side of the support agency.

It runs on the customer's machine, and it is the only thing there that talks to the customer's
ClickHouse on the support member's behalf. For each request, the customer decides whether
anything goes back to the support member through the realm, and what.

  gate enroll           install the two case rooms in your house, and grant the support member
                        INSERT on requests and SELECT on answers. Nothing else is granted.
  gate pending          requests not answered yet
  gate show <req_id>    check one request against the allowlist, run what it needs locally
                        (read-only), and store and print the exact answer. Nothing is sent.
  gate send <req_id> --yes --approved-by NAME
                        send exactly the stored preview. For a fix, apply it first and send
                        only the outcome.
  gate send <req_id> --auto
                        send without a human yes, only if the config's auto_approve lists the
                        request's kind (a fix is never sent this way)
  gate deny <req_id> [--reason TEXT]
  gate end              revoke both grants: every case with the support member ends
  gate status

What is enforced here, and not only in the agent's instructions:
- Only typed requests run. Free SQL is refused, with or without a yes.
- No row of a user table is ever read. Diagnostics read system tables, SHOW CREATE and
  EXPLAIN, and nothing else.
- Literals are redacted from every text that leaves. An answer that would still echo a
  literal of the customer's own queries, or match a deny pattern, is refused.
- Nothing is sent without a stored preview, and the preview is what is sent.
- The customer's local credentials never leave this machine.

Config: $SUPPORT_GATE_CONFIG, default ~/.support-gate/config.json. See the skill's README.
"""
import base64, hashlib, json, os, re, sys, urllib.error, urllib.parse, urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
IDENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]{0,63}$")
REQ_ID = re.compile(r"^[A-Za-z0-9_-]{4,64}$")
GATE_TAG = "support-gate"
MAX_PAYLOAD = 64 * 1024
USER_AGENT = "support-gate/0.1"
DEFAULT_DENY = [r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"]


def die(msg, code=1):
    print(f"gate: {msg}", file=sys.stderr)
    sys.exit(code)


class Refused(Exception):
    """The allowlist said no. The reason may be sent; nothing else is."""


class LocalError(Exception):
    pass


# --- config and transport ------------------------------------------------------------

def load_config():
    path = os.path.expanduser(os.environ.get("SUPPORT_GATE_CONFIG", "~/.support-gate/config.json"))
    try:
        with open(path) as f:
            cfg = json.load(f)
    except (OSError, ValueError) as e:
        die(f"cannot read config {path}: {e}", 3)
    for k in ("realm_url", "realm_curlrc", "house", "support_member", "local_url", "local_curlrc"):
        if not cfg.get(k):
            die(f"config: {k} is missing", 3)
    for k in ("house", "support_member"):
        if not IDENT.match(cfg[k]):
            die(f"config: {k} must be a plain name", 3)
    cfg["state_dir"] = os.path.expanduser(cfg.get("state_dir", "~/.support-gate/state"))
    os.makedirs(cfg["state_dir"], mode=0o700, exist_ok=True)
    cfg["auto_approve"] = [k for k in cfg.get("auto_approve", []) if k != "apply"]
    cfg["deny_patterns"] = [re.compile(p) for p in cfg.get("deny_patterns", DEFAULT_DENY)]
    return cfg


def curlrc_user(path):
    """The user line of a curl config file. The password stays in this process."""
    with open(os.path.expanduser(path)) as f:
        for line in f:
            m = re.match(r'\s*user\s*=\s*"([^":]+):(.*)"\s*$', line)
            if m:
                return m.group(1), m.group(2).replace('\\"', '"').replace("\\\\", "\\")
    die(f"no user line in {path}", 3)


def ch(url, auth, sql, params=None, fmt="JSONEachRow"):
    """POST one statement to a ClickHouse HTTP endpoint. Returns (ok, text)."""
    q = {"default_format": fmt}
    q.update(params or {})
    req = urllib.request.Request(url.rstrip("/") + "/?" + urllib.parse.urlencode(q),
                                 data=sql.encode(), method="POST")
    req.add_header("Authorization", "Basic " + base64.b64encode(f"{auth[0]}:{auth[1]}".encode()).decode())
    req.add_header("User-Agent", USER_AGENT)   # a realm behind a CDN may refuse the stdlib's default
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return True, r.read().decode()
    except urllib.error.HTTPError as e:
        return False, e.read().decode(errors="replace")
    except urllib.error.URLError as e:
        return False, f"unreachable: {e.reason}"


def rows(text):
    return [json.loads(line) for line in text.splitlines() if line.strip()]


def first_line(text):
    return (text.strip().splitlines() or [""])[0][:300]


def sql_str(s):
    return "'" + s.replace("\\", "\\\\").replace("'", "\\'") + "'"


class Gate:
    def __init__(self, cfg):
        self.cfg = cfg
        self.realm = (cfg["realm_url"], curlrc_user(cfg["realm_curlrc"]))
        self.local = (cfg["local_url"], curlrc_user(cfg["local_curlrc"]))
        self.house = cfg["house"]
        self.support = cfg["support_member"]

    def realm_q(self, sql, fmt="JSONEachRow"):
        ok, text = ch(*self.realm, sql, fmt=fmt)
        if not ok:
            die(f"the realm refused: {first_line(text)}")
        return text

    def read(self, sql):
        """A read on the customer's ClickHouse: readonly, and tagged, so the gate's own queries
        never count as the customer's workload."""
        ok, text = ch(*self.local, sql, params={"readonly": "2", "log_comment": GATE_TAG})
        if not ok:
            raise LocalError(first_line(text))
        return rows(text)

    def write(self, sql):
        return ch(*self.local, sql, fmt="TSV",
                  params={"log_comment": GATE_TAG, "mutations_sync": "2", "alter_sync": "2"})


# --- redaction -----------------------------------------------------------------------

STR_LIT = re.compile(r"'(?:[^'\\]|\\.|'')*'")
NUM_LIT = re.compile(r"(?<![A-Za-z_\d.])-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?")
CONDITION_LINE = re.compile(r"Condition|Filter|Prewhere|Expression|Description|Keys:|Ranges:")


def redact_strings(s):
    return STR_LIT.sub("'?'", s)


def redact_all(s):
    return NUM_LIT.sub("?", redact_strings(s))


def redact_explain(text):
    """Quoted strings everywhere; numbers too on the lines that can carry a query's values.
    The plan's shape, index names and part and granule counts stay readable."""
    out = []
    for line in redact_strings(text).splitlines():
        out.append(NUM_LIT.sub("?", line) if CONDITION_LINE.search(line) else line)
    return "\n".join(out)


def literals_of(texts):
    """Literals of the customer's own queries: what an answer must never echo. Strings of 3+
    characters, and numbers of 5+ digits (smaller ones are limits and counts, not data)."""
    found = set()
    for t in texts:
        for m in STR_LIT.finditer(t or ""):
            v = m.group(0)[1:-1]
            if len(v) >= 3:
                found.add(v)
        for m in NUM_LIT.finditer(t or ""):
            v = m.group(0).lstrip("-")
            if len(v.replace(".", "")) >= 5:
                found.add(v)
    return found


def screen(payload, literals, deny_patterns):
    for lit in literals:
        if re.fullmatch(r"[\d.]+", lit):
            hit = re.search(r"(?<![\d.])" + re.escape(lit) + r"(?![\d.])", payload)
        else:
            hit = lit in payload
        if hit:
            raise Refused("the answer would echo a literal of your queries")
    for p in deny_patterns:
        if p.search(payload):
            raise Refused("the answer matches one of your deny patterns")


# --- the allowlist: one function per kind ---------------------------------------------
# Each returns (sql_shown, result, literals). sql_shown is the local SQL, shown to the human
# and sent with the answer; literals are the customer's own literals the answer must not echo.

USER_DBS = "database NOT IN ('system', 'INFORMATION_SCHEMA', 'information_schema')"
WORKLOAD = (f"type = 'QueryFinish' AND query_kind = 'Select' AND log_comment != '{GATE_TAG}' "
            "AND NOT has(databases, 'system')")


def arg_int(args, key, lo, hi, default):
    v = args.get(key, default)
    if not isinstance(v, int) or isinstance(v, bool) or not lo <= v <= hi:
        raise Refused(f"argument {key} must be an integer from {lo} to {hi}")
    return v


def arg_ident(args, key):
    v = args.get(key)
    if not isinstance(v, str) or not IDENT.match(v):
        raise Refused(f"argument {key} must be a plain identifier")
    return v


def k_ack(g, args):
    for k, v in args.items():
        if not isinstance(v, (str, list)) or len(json.dumps(v)) > 4000:
            raise Refused(f"argument {k} must be a short text")
    return "", [{"acknowledged": True}], []


def k_server_info(g, args):
    plain = "if(match(value, '^(-?[0-9.]+|true|false)$'), value, '(redacted)')"
    sql = ("SELECT version() AS version, uptime() AS uptime_s, "
           f"(SELECT groupArray((name, {plain})) FROM system.server_settings WHERE changed) AS server_settings_changed, "
           f"(SELECT groupArray((name, {plain})) FROM system.merge_tree_settings WHERE changed) AS merge_tree_settings_changed")
    return sql, g.read(sql), []


def k_tables_overview(g, args):
    sql = ("SELECT database, table, any(engine) AS engine, sum(rows) AS rows, "
           "sum(bytes_on_disk) AS bytes_on_disk, count() AS active_parts, uniqExact(partition_id) AS partitions "
           f"FROM system.parts WHERE active AND {USER_DBS} "
           "GROUP BY database, table ORDER BY bytes_on_disk DESC LIMIT 50")
    return sql, g.read(sql), []


def k_table_schema(g, args):
    db, t = arg_ident(args, "database"), arg_ident(args, "table")
    if db.lower() in ("system", "information_schema"):
        raise Refused("system tables need no schema request")
    sql = f"SHOW CREATE TABLE `{db}`.`{t}`"
    r = g.read(sql)
    for row in r:
        row["statement"] = redact_strings(row.get("statement", ""))
    return sql, r, []


def k_parts_health(g, args):
    sql = ("SELECT database, table, max(c) AS max_parts_in_one_partition, sum(c) AS active_parts, "
           "(SELECT count() FROM system.merges) AS merges_running "
           "FROM (SELECT database, table, partition_id, count() AS c FROM system.parts "
           f"WHERE active AND {USER_DBS} GROUP BY database, table, partition_id) "
           "GROUP BY database, table ORDER BY max_parts_in_one_partition DESC LIMIT 50")
    return sql, g.read(sql), []


def k_slow_queries(g, args):
    hours = arg_int(args, "hours", 1, 168, 24)
    limit = arg_int(args, "limit", 1, 20, 10)
    where = f"event_date >= today() - 8 AND event_time >= now() - INTERVAL {hours} HOUR AND {WORKLOAD}"
    sql = ("SELECT toString(normalized_query_hash) AS normalized_query_hash, "
           "any(normalizeQuery(query)) AS query_shape, count() AS runs, "
           "round(quantile(0.5)(query_duration_ms)) AS p50_ms, max(query_duration_ms) AS max_ms, "
           "round(avg(read_rows)) AS avg_read_rows, round(avg(read_bytes)) AS avg_read_bytes, "
           "round(avg(memory_usage)) AS avg_memory_bytes "
           f"FROM system.query_log WHERE {where} GROUP BY normalized_query_hash "
           f"ORDER BY sum(query_duration_ms) DESC LIMIT {limit}")
    r = g.read(sql)
    for row in r:                         # normalizeQuery removes literals; redact any survivor
        row["query_shape"] = redact_all(row["query_shape"])
    seen = g.read(f"SELECT groupUniqArray(200)(query) AS q FROM system.query_log WHERE {where}")
    return sql, r, literals_of(seen[0]["q"] if seen else [])


def k_explain(g, args):
    h = args.get("normalized_query_hash")
    if not isinstance(h, str) or not h.isdigit() or len(h) > 20:
        raise Refused("argument normalized_query_hash must be the decimal hash from slow_queries")
    mode = args.get("mode", "indexes")
    if mode not in ("indexes", "plan"):
        raise Refused("argument mode must be indexes or plan")
    r = g.read("SELECT query AS q, normalizeQuery(query) AS shape FROM system.query_log "
               f"WHERE event_date >= today() - 8 AND normalized_query_hash = {h} AND {WORKLOAD} "
               "ORDER BY event_time DESC LIMIT 1")
    if not r:
        raise Refused("no query with that hash in your log")
    sample = re.sub(r"\s+FORMAT\s+\w+\s*$", "", r[0]["q"].strip().rstrip(";").strip(), flags=re.I)
    if ";" in sample:
        raise Refused("that query is not a single statement")
    head = "EXPLAIN indexes = 1 " if mode == "indexes" else "EXPLAIN "
    plan = "\n".join(x["explain"] for x in g.read(head + sample))
    return head + redact_all(r[0]["shape"]), [{"plan": redact_explain(plan)}], literals_of([sample])


def k_errors(g, args):
    sql = ("SELECT name, code, value AS count, toString(last_error_time) AS last_error_time, "
           "last_error_message FROM system.errors WHERE value > 0 ORDER BY last_error_time DESC LIMIT 30")
    r = g.read(sql)
    for row in r:
        row["last_error_message"] = redact_all(row.get("last_error_message", ""))[:300]
    failed = g.read("SELECT groupUniqArray(200)(query) AS q FROM system.query_log WHERE event_date >= today() - 8 "
                    f"AND type != 'QueryFinish' AND type != 'QueryStart' AND log_comment != '{GATE_TAG}'")
    return sql, r, literals_of(failed[0]["q"] if failed else [])


TABLE = r"`?[A-Za-z_][A-Za-z0-9_]*`?\.`?[A-Za-z_][A-Za-z0-9_]*`?"
NAME = r"[A-Za-z_][A-Za-z0-9_]*"
COLS = rf"(?:\*|{NAME}(?:\s*,\s*{NAME})*)"
FIXES = [re.compile(p, re.I) for p in (
    rf"ALTER TABLE {TABLE} ADD PROJECTION (?:IF NOT EXISTS )?{NAME} \(\s*SELECT {COLS} ORDER BY \(?\s*{COLS}\s*\)?\s*\)",
    rf"ALTER TABLE {TABLE} MATERIALIZE PROJECTION {NAME}",
    rf"ALTER TABLE {TABLE} ADD INDEX (?:IF NOT EXISTS )?{NAME} {NAME} TYPE (?:minmax|set\(\d+\)|bloom_filter(?:\(0?\.\d+\))?) GRANULARITY \d+",
    rf"ALTER TABLE {TABLE} MATERIALIZE INDEX {NAME}",
    rf"OPTIMIZE TABLE {TABLE}(?: FINAL)?",
    rf"ALTER TABLE {TABLE} MODIFY SETTING {NAME} = \d+",
)]


def k_apply(g, args, run=False):
    stmts = args.get("statements")
    if not isinstance(stmts, list) or not 1 <= len(stmts) <= 5 or not all(isinstance(s, str) for s in stmts):
        raise Refused("argument statements must be a list of 1 to 5 statements")
    stmts = [s.strip().rstrip(";").strip() for s in stmts]
    for s in stmts:
        if re.search(r"[;'\"]|system\.|--|/\*", s, re.I) or not any(p.fullmatch(s) for p in FIXES):
            raise Refused("not an allowed fix: " + redact_all(s)[:160])
    if not run:
        return "\n".join(stmts), [{"would_run": s} for s in stmts], []
    out = []
    for s in stmts:
        ok, text = g.write(s)
        out.append({"statement": s, "ok": ok, "error": "" if ok else redact_all(first_line(text))})
        if not ok:
            break
    return "\n".join(stmts), out, []


KINDS = {"open": k_ack, "note": k_ack, "close": k_ack, "server_info": k_server_info,
         "tables_overview": k_tables_overview, "table_schema": k_table_schema,
         "parts_health": k_parts_health, "slow_queries": k_slow_queries, "explain": k_explain,
         "errors": k_errors, "apply": k_apply}


def build(g, req, run_fix=False):
    kind = req["kind"]
    try:
        args = json.loads(req["args"] or "{}")
    except ValueError:
        args = None
    if not isinstance(args, dict):
        raise Refused("the arguments are not a JSON object")
    if kind not in KINDS:
        raise Refused(f"'{kind}' is not an allowed request kind; free SQL is never run")
    if kind == "apply":
        sql, result, lits = k_apply(g, args, run=run_fix)
    else:
        sql, result, lits = KINDS[kind](g, args)
    payload = json.dumps({"kind": kind, "local_sql": sql, "result": result}, sort_keys=True, default=str)
    screen(payload, lits, g.cfg["deny_patterns"])
    if len(payload) > MAX_PAYLOAD:
        raise Refused("the answer would be larger than 64 KB")
    return payload


# --- commands ------------------------------------------------------------------------

def cmd_enroll(g, argv):
    with open(os.path.join(HERE, "..", "enroll.sql")) as f:
        text = "\n".join(l for l in f.read().splitlines() if not l.startswith("--"))
    for stmt in (s.strip() for s in text.split(";\n")):
        if stmt:
            g.realm_q(stmt.rstrip(";").replace("{house}", g.house).replace("{support}", g.support), fmt="TSV")
    print(f"enrolled: {g.support} may INSERT on {g.house}.support_requests and SELECT on "
          f"{g.house}.support_answers, and nothing else")


def pending(g):
    return rows(g.realm_q(
        "SELECT r.case_id AS case_id, r.req_id AS req_id, toString(r.at) AS at, r.author AS author, "
        f"r.kind AS kind, r.args AS args FROM {g.house}.support_requests AS r "
        f"LEFT ANTI JOIN {g.house}.support_answers AS a ON a.req_id = r.req_id ORDER BY r.at"))


def cmd_pending(g, argv):
    reqs = pending(g)
    if not reqs:
        print("no pending requests")
    for r in reqs:
        print(f"{r['req_id']}  case {r['case_id']}  {r['kind']}  {r['args']}  (from {r['author']}, {r['at']})")


def find_request(g, req_id):
    if not REQ_ID.match(req_id):
        die("bad request id", 3)
    r = rows(g.realm_q(f"SELECT case_id, req_id, author, kind, args FROM {g.house}.support_requests "
                       f"WHERE req_id = {sql_str(req_id)}"))
    if not r:
        die(f"no request {req_id}")
    if len(r) > 1:
        die(f"request id {req_id} was used twice: refusing to act on it")
    if r[0]["author"] != g.support:
        die(f"request {req_id} is from {r[0]['author']}, not {g.support}: refusing to act on it")
    return r[0]


def state_path(g, req_id):
    return os.path.join(g.cfg["state_dir"], f"{req_id}.json")


def save_state(g, req_id, state):
    fd = os.open(state_path(g, req_id), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump(state, f)


def cmd_show(g, argv):
    if not argv:
        die("usage: gate show <req_id>", 3)
    req = find_request(g, argv[0])
    print(f"request {req['req_id']} (case {req['case_id']}) from {req['author']}: {req['kind']} {req['args']}")
    try:
        payload = build(g, req)
    except Refused as e:
        save_state(g, req["req_id"], {"req": req, "refused": str(e)})
        print(f"REFUSED: {e}")
        print("Nothing ran. Sending the refusal tells support only the reason above.")
        return
    except LocalError as e:
        die(f"your ClickHouse refused: {e}")
    sha = hashlib.sha256(payload.encode()).hexdigest()
    save_state(g, req["req_id"], {"req": req, "payload": payload, "sha256": sha})
    if req["kind"] == "apply":
        print("This CHANGES your ClickHouse. On your yes these statements run, and support gets back "
              "only whether each one succeeded:")
    else:
        print("Ran locally, read-only. On your yes, exactly this goes to support:")
    print(json.dumps(json.loads(payload), indent=1))
    print(f"sha256 {sha}")


def post_answer(g, req, status, approved_by, reason, payload):
    row = {"case_id": req["case_id"], "req_id": req["req_id"], "status": status, "approved_by": approved_by,
           "reason": reason, "payload": payload, "payload_sha256": hashlib.sha256(payload.encode()).hexdigest()}
    g.realm_q(f"INSERT INTO {g.house}.support_answers "
              "(case_id, req_id, status, approved_by, reason, payload, payload_sha256) FORMAT JSONEachRow\n"
              + json.dumps(row), fmt="TSV")


def opt(argv, name):
    if name in argv and argv.index(name) + 1 < len(argv):
        return argv[argv.index(name) + 1]
    return None


def cmd_send(g, argv):
    if not argv:
        die("usage: gate send <req_id> --yes --approved-by NAME | --auto", 3)
    req = find_request(g, argv[0])
    if "--auto" in argv:
        if req["kind"] not in g.cfg["auto_approve"]:
            die(f"'{req['kind']}' is not in your auto_approve list: it needs a human yes", 3)
        who = "policy:auto_approve"
    else:
        who = opt(argv, "--approved-by")
        if "--yes" not in argv or not who:
            die("nothing is sent without --yes and --approved-by NAME, given after the human said yes "
                "to the preview", 3)
    try:
        with open(state_path(g, req["req_id"])) as f:
            st = json.load(f)
    except (OSError, ValueError):
        die("no preview for this request: run gate show first", 3)
    if st.get("req") != req:
        die("the request differs from the one previewed: run gate show again")
    if "refused" in st:
        post_answer(g, req, "refused", "", st["refused"], "")
        print(f"sent: refused ({st['refused']})")
        return
    payload = st["payload"]
    if hashlib.sha256(payload.encode()).hexdigest() != st["sha256"]:
        die("the stored preview was altered: run gate show again")
    status = "acknowledged" if req["kind"] in ("open", "note", "close") else "answered"
    if req["kind"] == "apply":
        try:
            payload = build(g, req, run_fix=True)
        except Refused as e:
            post_answer(g, req, "refused", "", str(e), "")
            print(f"sent: refused ({e})")
            return
        status = "applied" if all(r["ok"] for r in json.loads(payload)["result"]) else "failed"
    post_answer(g, req, status, who, "", payload)
    print(f"sent: {status} (approved by {who})")


def cmd_deny(g, argv):
    if not argv:
        die("usage: gate deny <req_id> [--reason TEXT]", 3)
    req = find_request(g, argv[0])
    reason = (opt(argv, "--reason") or "the customer said no")[:300]
    post_answer(g, req, "denied", "", reason, "")
    print(f"sent: denied ({reason})")


def cmd_end(g, argv):
    g.realm_q(f"REVOKE INSERT ON {g.house}.support_requests FROM {g.support}", fmt="TSV")
    g.realm_q(f"REVOKE SELECT ON {g.house}.support_answers FROM {g.support}", fmt="TSV")
    print(f"ended: {g.support} holds no grant on {g.house}")


def cmd_status(g, argv):
    answers = rows(g.realm_q(f"SELECT status, count() AS n FROM {g.house}.support_answers GROUP BY status"))
    print(f"house {g.house}; support member {g.support}; pending {len(pending(g))}; answers: "
          + (", ".join(f"{a['status']} {a['n']}" for a in answers) or "none"))


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__)
        return
    cmds = {"enroll": cmd_enroll, "pending": cmd_pending, "show": cmd_show, "send": cmd_send,
            "deny": cmd_deny, "end": cmd_end, "status": cmd_status}
    if sys.argv[1] not in cmds:
        die(f"unknown command {sys.argv[1]}", 3)
    cmds[sys.argv[1]](Gate(load_config()), sys.argv[2:])


if __name__ == "__main__":
    main()
